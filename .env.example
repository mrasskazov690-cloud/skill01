# Скопируйте в .env (chmod 600) и заполните. .env не попадает в Git.
# Пустое значение = значение по умолчанию из app/config.py.

# PostgreSQL рабочей базы, формат: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# PostgreSQL для pytest. Тесты создают и удаляют временные базы на этом сервере,
# поэтому роли нужно право CREATEDB. Рабочую базу сюда не указывать.
TEST_DATABASE_URL=

# Уровень логов: DEBUG, INFO, WARNING, ERROR, CRITICAL (по умолчанию INFO)
LOG_LEVEL=

# Сколько раз пробовать отправку при FLOOD_WAIT, затем ручная проверка (по умолчанию 3)
DISPATCH_MAX_SEND_ATTEMPTS=

# Аренда сообщения в статусе processing, секунд (по умолчанию 300)
DISPATCH_LEASE_SECONDS=

# Сколько pending-кандидатов dispatch_one перебирает за один вызов (по умолчанию 10)
DISPATCH_CANDIDATE_LIMIT=

# Порядок выдачи заявок: newest_first (по умолчанию, самая новая первой) или oldest_first
DISPATCH_ORDER=

# Telegram MTProto: api_id и api_hash с my.telegram.org (api_hash — секрет)
TG_API_ID=
TG_API_HASH=

# Рабочий чат с заявками и аккаунт, который его читает (id из таблицы accounts)
WORK_CHAT_ID=
READER_ACCOUNT_ID=

# Сессии аккаунтов: по одной переменной на аккаунт, имя переменной хранится в
# accounts.session_env, например TG_SESSION_ANNA. Значения — секреты, сюда не писать.
# TG_SESSION_<ИМЯ>=

# Только для tests/integration/test_test_dc.py: сессии двух аккаунтов тестовых серверов
# Telegram (python -m app.telegram.login --test-dc). Без них тест пропускается.
# TG_TEST_SESSION_A=
# TG_TEST_SESSION_B=

# Как часто читать рабочий чат, секунд (по умолчанию 15)
WORK_CHAT_POLL_SECONDS=

# Сколько последних сообщений рабочего чата взять при первом запуске (по умолчанию 200)
WORK_CHAT_BACKFILL=

# Не больше одной отправки во всей системе за этот интервал, секунд (по умолчанию 120)
SEND_INTERVAL_SECONDS=

# Отправок в сутки с одного аккаунта, если в accounts.daily_send_limit пусто (по умолчанию 20)
ACCOUNT_DAILY_LIMIT=

# Сколько первых ответов отправляются только после подтверждения владельцем (по умолчанию 20)
CONFIRM_FIRST_N=

# Часовой пояс, в котором считаются сутки для дневного лимита (по умолчанию Europe/Moscow)
TIMEZONE=

# Повторять неопределённую отправку с тем же random_id (по умолчанию false, не проверено)
SEND_RETRY_UNCERTAIN_WITH_RANDOM_ID=
